{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "ignoreDeprecations": "5.0",
    "paths": {
      "@xcarbox/i18n": ["./packages/platform/i18n/index.ts"],
      "@xcarbox/ui": ["./packages/platform/ui/src/index.ts"],
      "@xcarbox/ui/*": ["./packages/platform/ui/src/*"],
      "@xcarbox/api": ["./packages/platform/api/index.ts"],
      "@xcarbox/contracts": ["./packages/platform/contracts/index.ts"],
      "@xcarbox/auth": ["./packages/platform/auth/index.ts"],
      "@xcarbox/cars": ["./packages/domains/cars/src/index.ts"],
      "@xcarbox/cars/*": ["./packages/domains/cars/src/*"],
      "@xcarbox/checkout": ["./packages/workflows/checkout/src/index.ts"],
      "@xcarbox/checkout/*": ["./packages/workflows/checkout/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}